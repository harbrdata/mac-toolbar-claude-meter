{
  "branches": [
    "main"
  ],
  "tagFormat": "${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/exec", { "prepareCmd": "./ci/prepare_release.sh ${nextRelease.version}" }],
    ["@semantic-release/git", { "assets": ["CHANGELOG.md", "VERSION", "Cargo.toml", "Cargo.lock"], "message": "chore(release): ${nextRelease.version} [skip ci]" }],
    ["@semantic-release/github", { "assets": [{ "path": "dist/Claude-o-Meter.dmg", "label": "Claude-o-Meter.dmg" }] }]
  ]
}
